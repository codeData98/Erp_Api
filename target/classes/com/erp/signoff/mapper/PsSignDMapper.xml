<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
  位置约定：与 Mapper 接口保持相同的包路径
    Java : src/main/java/com/erp/signoff/mapper/PsSignMMapper.java
    XML  : src/main/resources/com/erp/signoff/mapper/PsSignMMapper.xml
  编译后二者都会落到 target/classes/com/erp/signoff/mapper/ 下，
  MyBatis 按 "namespace 全限定名 + .xml" 的约定自动加载，无需配置 mapper-locations。
-->
<mapper namespace="com.erp.signoff.mapper.PsSignDMapper">
<!--    根据headerId获取到最大的LineId-->
    <select id="getLineIdByHeaderId" resultType="int">
        select coalesce(max(line_id),1) from ps_sign_d where org_id = #{orgId} and header_id = #{headerId}
    </select>
<!--    插入数据到签收D档-->
    <insert id="insertDataToPsSignD">
        insert into PS_SIGN_D(org_id,header_id,line_id,sales_id,sales_seq,se_id,se_seq,prod_no,rp_pt,part,is_mult,
                              sign_qty,cre_user,cre_date,last_user,last_date,rcpt_no,rcpt_org_id) values
        <foreach collection="psSignDList" item="item" separator=",">
            (#{item.orgId}, #{item.headerId}, #{item.lineId}, #{item.salesId},
            #{item.salesNo}, #{item.salesSeq}, #{item.seId}, #{item.seSeq},
            #{item.prodNo}, #{item.rpPt}, #{item.part}, #{item.isMult},
            #{item.signQty}, #{item.creUser}, #{item.creDate}, #{item.lastUser},
            #{item.lastDate}, #{item.rcptNo}, #{item.rcptOrgId})
        </foreach>
    </insert>
</mapper>
