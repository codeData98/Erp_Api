<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
  位置约定：与 Mapper 接口保持相同的包路径
    Java : src/main/java/com/erp/signoff/mapper/SysOrgMapper.java
    XML  : src/main/resources/com/erp/signoff/mapper/SysOrgMapper.xml
  编译后二者都会落到 target/classes/com/erp/signoff/mapper/ 下，
  MyBatis 按 "namespace 全限定名 + .xml" 的约定自动加载，无需配置 mapper-locations。
-->
<mapper namespace="com.erp.signoff.mapper.SysOrgMapper">
    <!-- 厂商代码 -> 组织（原 PL/SQL：SELECT ORG_ID FROM vw_group_org_vend WHERE VEND_NO = ?） -->
    <select id="getOrgListByVendNo" resultType="com.erp.signoff.entity.SysOrg">
        select * from sys_org where vend_no = #{vendNo}
    </select>

    <!-- 组织 -> 客户ID -->
    <select id="getCustIdByOrgId" resultType="java.lang.String">
        select cust_id from sys_org where org_id = #{orgId} limit 1
    </select>
</mapper>
